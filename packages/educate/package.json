{
	"name": "@prisma-intent/educate",
	"version": "0.1.0",
	"description": "PRISMA Intent — especialização Educate: educação e aprendizagem em qualquer idade. Quem aprende, quem decide e quem acompanha; histórias com intenção, missões fora da tela e rotina, com objetivo observável.",
	"license": "MIT",
	"author": {
		"name": "Sidarta Veloso",
		"url": "https://sidartaveloso.com"
	},
	"homepage": "https://github.com/sidartaveloso/prisma-intent/tree/main/packages/educate#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sidartaveloso/prisma-intent.git",
		"directory": "packages/educate"
	},
	"bugs": {
		"url": "https://github.com/sidartaveloso/prisma-intent/issues"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json && tsx scripts/emitir.ts",
		"emitir": "tsx scripts/emitir.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "tsx --test test/*.test.ts"
	},
	"devDependencies": {
		"@types/node": "^26.6.7",
		"tsx": "^4.20.0",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"@prisma-intent/core": "workspace:*"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			}
		},
		"types": "./dist/index.d.ts"
	}
}
